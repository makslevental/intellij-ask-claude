<idea-plugin>
  <id>dev.makslevental.intellij-ask-claude</id>
  <name>Ask Claude</name>
  <version>0.1.0</version>
  <vendor email="maksim.levental@gmail.com">makslevental</vendor>
  <description><![CDATA[
    Select code, press the shortcut, type a question in a small popup, and send it to the Claude Code session
    running in the IDE's Terminal tool window, together with a file and line-range reference
    (<code>@src/Foo.kt#L10-20</code>). The message is submitted and the editor keeps focus.
    Requires Claude Code to be installed; if no session is running, one is started in a new Terminal tab.
  ]]></description>
  <idea-version since-build="262"/>
  <!-- Same shape as the bundled plugins that use the terminal (e.g. mcpserver). -->
  <dependencies>
    <plugin id="com.intellij.modules.platform"/>
    <plugin id="org.jetbrains.plugins.terminal"/>
    <module name="intellij.terminal.frontend"/>
  </dependencies>

  <extensions defaultExtensionNs="com.intellij">
    <notificationGroup id="Ask Claude" displayType="BALLOON"/>
    <applicationService serviceImplementation="dev.makslevental.claudeask.AskClaudeSettings"/>
    <applicationConfigurable parentId="tools" id="dev.makslevental.claudeask.settings"
                             instance="dev.makslevental.claudeask.AskClaudeConfigurable" displayName="Ask Claude"/>
  </extensions>

  <actions>
    <action id="AskClaude.Ask" class="dev.makslevental.claudeask.AskClaudeAction" text="Ask Claude..."
            description="Ask Claude Code about the selected lines and send it to the running session">
      <keyboard-shortcut keymap="$default" first-keystroke="alt ctrl shift K"/>
      <add-to-group group-id="EditorPopupMenu" anchor="last"/>
    </action>
  </actions>
</idea-plugin>
